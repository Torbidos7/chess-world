# Chess World Environment Variables

# Database — SQLite (locale) o PostgreSQL (Supabase)
DATABASE_URL=sqlite:///./chess_world.db
# Per Supabase usa: postgresql://user:password@host:6542/dbname?sslmode=require

# Chess Engines
STOCKFISH_PATH=/usr/local/bin/stockfish
CHESS_API_URL=https://chess-api.com/v1
CHESS_API_KEY=  # Optional, for higher rate limits

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# Lichess API (no key needed)
LICHESS_API_URL=https://lichess.org/api

# Server Configuration
HOST=0.0.0.0
PORT=8001

# Auth
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,https://torbidos7.github.io
