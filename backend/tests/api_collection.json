{
  "info": {
    "name": "Chess World API",
    "description": "Collection Postman per testare ogni endpoint del backend Chess World singolarmente, senza passare dal frontend. Usa le variabili di ambiente BASE_URL e TOKEN (TOKEN viene salvato automaticamente dopo login/signup).",
    "_postman_id": "chess-world-api-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const j = pm.response.json();",
                  "pm.environment.set('TOKEN', j.access_token);",
                  "console.log('TOKEN salvato:', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"test123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/signup",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "signup"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const j = pm.response.json();",
                  "pm.environment.set('TOKEN', j.access_token);",
                  "console.log('TOKEN salvato:', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"test123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/profile",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "Get Game History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/games?limit=20",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "games"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          },
          "response": []
        },
        {
          "name": "Send Friend Request",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"friend_username\": \"{{FRIEND}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/friends/add",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "friends", "add"]
            }
          },
          "response": []
        },
        {
          "name": "Accept Friend Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/friends/accept?friend_username={{FRIEND}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "friends", "accept"],
              "query": [{ "key": "friend_username", "value": "{{FRIEND}}" }]
            }
          },
          "response": []
        },
        {
          "name": "List Friends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/friends",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "friends"]
            }
          },
          "response": []
        },
        {
          "name": "Incoming Friend Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/friends/requests",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "friends", "requests"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Friend",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/users/{{USERNAME}}/friends/remove?friend_username={{FRIEND}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "{{USERNAME}}", "friends", "remove"],
              "query": [{ "key": "friend_username", "value": "{{FRIEND}}" }]
            }
          },
          "response": []
        }
      ]
    },
